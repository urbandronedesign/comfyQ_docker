{
  "name": "comfyq-console-app",
  "version": "0.1.18",
  "description": "ComfyQ Console — launch, watch and pay for ComfyQ machines on RunPod and Thunder Compute",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test/watch.test.js && node test/app-smoke.mjs",
    "prepare-resources": "node scripts/prepare.cjs",
    "dist": "node scripts/prepare.cjs && electron-builder --win --publish never",
    "release:patch": "npm version patch --no-git-tag-version && node scripts/release.mjs",
    "release:minor": "npm version minor --no-git-tag-version && node scripts/release.mjs",
    "release:major": "npm version major --no-git-tag-version && node scripts/release.mjs"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
